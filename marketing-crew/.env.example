# Select which backend the agents use: groq (default) | gemini
MKT_BACKEND=groq

# --- Groq backend (default) ---
GROQ_API_KEY=gsk_your_key_here
MKT_MODEL=groq/llama-3.3-70b-versatile

# --- Gemini backend (optional alternative) ---
GEMINI_API_KEY=your_gemini_key_here
MKT_MODEL_GEMINI=gemini/gemini-2.0-flash
